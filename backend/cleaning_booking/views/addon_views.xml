<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Add-on Tree View ── -->
    <record id="view_clean_addon_tree" model="ir.ui.view">
        <field name="name">clean.addon.tree</field>
        <field name="model">clean.addon</field>
        <field name="arch" type="xml">
            <list string="Add-ons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="duration_delta"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Add-on Form View ── -->
    <record id="view_clean_addon_form" model="ir.ui.view">
        <field name="name">clean.addon.form</field>
        <field name="model">clean.addon</field>
        <field name="arch" type="xml">
            <form string="Add-on">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Add-on name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="price"/>
                            <field name="duration_delta"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Add-on Action ── -->
    <record id="action_clean_addon" model="ir.actions.act_window">
        <field name="name">Add-ons</field>
        <field name="res_model">clean.addon</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first cleaning add-on service.
            </p>
        </field>
    </record>
</odoo>
