<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Bedroom Option List View ── -->
    <record id="view_clean_bedroom_option_tree" model="ir.ui.view">
        <field name="name">clean.bedroom.option.tree</field>
        <field name="model">clean.bedroom.option</field>
        <field name="arch" type="xml">
            <list string="Bedroom Options" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="value"/>
                <field name="surcharge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Bedroom Option Form View ── -->
    <record id="view_clean_bedroom_option_form" model="ir.ui.view">
        <field name="name">clean.bedroom.option.form</field>
        <field name="model">clean.bedroom.option</field>
        <field name="arch" type="xml">
            <form string="Bedroom Option">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Label..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="value"/>
                            <field name="surcharge"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Bedroom Option Action ── -->
    <record id="action_clean_bedroom_option" model="ir.actions.act_window">
        <field name="name">Bedroom Options</field>
        <field name="res_model">clean.bedroom.option</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define bedroom count options and their surcharges.
            </p>
        </field>
    </record>
</odoo>
