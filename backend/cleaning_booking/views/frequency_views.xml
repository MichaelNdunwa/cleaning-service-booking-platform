<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Frequency List View ── -->
    <record id="view_clean_frequency_tree" model="ir.ui.view">
        <field name="name">clean.frequency.tree</field>
        <field name="model">clean.frequency</field>
        <field name="arch" type="xml">
            <list string="Frequencies" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="discount_pct"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Frequency Form View ── -->
    <record id="view_clean_frequency_form" model="ir.ui.view">
        <field name="name">clean.frequency.form</field>
        <field name="model">clean.frequency</field>
        <field name="arch" type="xml">
            <form string="Frequency">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Frequency name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="discount_pct"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Frequency Action ── -->
    <record id="action_clean_frequency" model="ir.actions.act_window">
        <field name="name">Frequencies</field>
        <field name="res_model">clean.frequency</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define booking frequencies and their discount rates.
            </p>
        </field>
    </record>
</odoo>
