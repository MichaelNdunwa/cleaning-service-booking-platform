<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Pricing Tree View ── -->
    <record id="view_clean_pricing_tree" model="ir.ui.view">
        <field name="name">clean.pricing.tree</field>
        <field name="model">clean.pricing</field>
        <field name="arch" type="xml">
            <list string="Property Size Tiers" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="label"/>
                <field name="name"/>
                <field name="code"/>
                <field name="pricing_type"/>
                <field name="bedrooms" invisible="pricing_type != 'bedroom'"/>
                <field name="base_price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Pricing Form View ── -->
    <record id="view_clean_pricing_form" model="ir.ui.view">
        <field name="name">clean.pricing.form</field>
        <field name="model">clean.pricing</field>
        <field name="arch" type="xml">
            <form string="Property Size Tier">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Plan name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="pricing_type"/>
                            <field name="bedrooms" invisible="pricing_type != 'bedroom'"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Pricing Search View ── -->
    <record id="view_clean_pricing_search" model="ir.ui.view">
        <field name="name">clean.pricing.search</field>
        <field name="model">clean.pricing</field>
        <field name="arch" type="xml">
            <search string="Search Property Size Tiers">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="filter_bedroom" string="By Bedroom" domain="[('pricing_type', '=', 'bedroom')]"/>
                <filter name="filter_flat" string="Flat Rate" domain="[('pricing_type', '=', 'flat')]"/>
                <group>
                    <filter name="groupby_pricing_type" string="Pricing Type" context="{'group_by': 'pricing_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Pricing Action ── -->
    <record id="action_clean_pricing" model="ir.actions.act_window">
        <field name="name">Property Size Tiers</field>
        <field name="res_model">clean.pricing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clean_pricing_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your property size tiers and their base prices.
            </p>
        </field>
    </record>
</odoo>
