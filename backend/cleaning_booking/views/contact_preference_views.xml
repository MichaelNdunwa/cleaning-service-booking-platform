<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Contact Preference List View ── -->
    <record id="view_clean_contact_preference_tree" model="ir.ui.view">
        <field name="name">clean.contact.preference.tree</field>
        <field name="model">clean.contact.preference</field>
        <field name="arch" type="xml">
            <list string="Contact Preferences" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Contact Preference Form View ── -->
    <record id="view_clean_contact_preference_form" model="ir.ui.view">
        <field name="name">clean.contact.preference.form</field>
        <field name="model">clean.contact.preference</field>
        <field name="arch" type="xml">
            <form string="Contact Preference">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Preference name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Contact Preference Action ── -->
    <record id="action_clean_contact_preference" model="ir.actions.act_window">
        <field name="name">Contact Preferences</field>
        <field name="res_model">clean.contact.preference</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define how customers prefer to be contacted.
            </p>
        </field>
    </record>
</odoo>
