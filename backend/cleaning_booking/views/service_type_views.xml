<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Service Type Tree View ── -->
    <record id="view_clean_service_type_tree" model="ir.ui.view">
        <field name="name">clean.service.type.tree</field>
        <field name="model">clean.service.type</field>
        <field name="arch" type="xml">
            <list string="Service Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="bedrooms" invisible="category != 'property'"/>
                <field name="base_price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Service Type Form View ── -->
    <record id="view_clean_service_type_form" model="ir.ui.view">
        <field name="name">clean.service.type.form</field>
        <field name="model">clean.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Service name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="bedrooms" invisible="category != 'property'"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Service Type Action ── -->
    <record id="action_clean_service_type" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">clean.service.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your cleaning service types and pricing.
            </p>
        </field>
    </record>
</odoo>
