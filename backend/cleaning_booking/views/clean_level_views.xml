<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Clean Level Tree View ── -->
    <record id="view_clean_level_tree" model="ir.ui.view">
        <field name="name">clean.level.tree</field>
        <field name="model">clean.level</field>
        <field name="arch" type="xml">
            <list string="Clean Level Surcharges" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="base_price" string="Surcharge"/>
                <field name="duration"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Clean Level Form View ── -->
    <record id="view_clean_level_form" model="ir.ui.view">
        <field name="name">clean.level.form</field>
        <field name="model">clean.level</field>
        <field name="arch" type="xml">
            <form string="Clean Level">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Level name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="base_price" string="Surcharge"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Clean Level Action ── -->
    <record id="action_clean_level" model="ir.actions.act_window">
        <field name="name">Clean Levels</field>
        <field name="res_model">clean.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your cleaning levels and surcharge pricing.
            </p>
        </field>
    </record>
</odoo>
