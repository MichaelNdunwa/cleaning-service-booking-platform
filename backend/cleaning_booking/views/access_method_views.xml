<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ── Access Method List View ── -->
    <record id="view_clean_access_method_tree" model="ir.ui.view">
        <field name="name">clean.access.method.tree</field>
        <field name="model">clean.access.method</field>
        <field name="arch" type="xml">
            <list string="Access Methods" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Access Method Form View ── -->
    <record id="view_clean_access_method_form" model="ir.ui.view">
        <field name="name">clean.access.method.form</field>
        <field name="model">clean.access.method</field>
        <field name="arch" type="xml">
            <form string="Access Method">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Method name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Access Method Action ── -->
    <record id="action_clean_access_method" model="ir.actions.act_window">
        <field name="name">Access Methods</field>
        <field name="res_model">clean.access.method</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define how cleaners can access the property.
            </p>
        </field>
    </record>
</odoo>
